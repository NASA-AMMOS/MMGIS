{
    "defaultIcon": "video",
    "description": "Create animated sequences of map data with custom time ranges and export options.",
    "descriptionFull": {
        "title": "The Animation tool allows users to create smooth animated sequences of map data by selecting a bounding box area, defining a time range, and configuring playback options. Users can export animations as GIF, MP4, or other formats.",
        "example": {
            "defaultFrameRate": 2,
            "maxFrames": 100,
            "defaultTimeInterval": "day",
            "enableGifExport": true,
            "enableVideoExport": true,
            "cacheSize": 50,
            "defaultBoundingBox": {
                "north": 90,
                "south": -90,
                "east": 180,
                "west": -180
            }
        }
    },
    "hasVars": true,
    "name": "Animation",
    "toolbarPriority": 1002,
    "paths": {
        "AnimationTool": "essence/Tools/Animation/AnimationTool"
    },
    "expandable": true,
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.defaultFrameRate",
                        "name": "Default Frame Rate",
                        "description": "Default frames per second for animation playback (0.5 - 10)",
                        "type": "number",
                        "width": 4,
                        "min": 0.5,
                        "max": 10,
                        "step": 0.5,
                        "default": 2
                    },
                    {
                        "field": "variables.maxFrames",
                        "name": "Maximum Frames",
                        "description": "Maximum number of frames allowed in an animation",
                        "type": "number",
                        "width": 4,
                        "min": 10,
                        "max": 1000,
                        "step": 10,
                        "default": 100
                    },
                    {
                        "field": "variables.cacheSize",
                        "name": "Cache Size",
                        "description": "Number of map images to cache for smooth playback",
                        "type": "number",
                        "width": 4,
                        "min": 10,
                        "max": 200,
                        "step": 10,
                        "default": 50
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.defaultTimeInterval",
                        "name": "Default Time Interval",
                        "description": "Default time interval between animation frames",
                        "type": "dropdown",
                        "width": 4,
                        "options": ["hour", "day", "week", "month", "year"],
                        "default": "day"
                    },
                    {
                        "field": "variables.enableGifExport",
                        "name": "Enable GIF Export",
                        "description": "Allow users to export animations as GIF files",
                        "type": "checkbox",
                        "width": 4,
                        "defaultChecked": true
                    },
                    {
                        "field": "variables.enableVideoExport",
                        "name": "Enable Video Export",
                        "description": "Allow users to export animations as MP4 video files",
                        "type": "checkbox",
                        "width": 4,
                        "defaultChecked": false
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.defaultBoundingBox",
                        "name": "Default Bounding Box",
                        "description": "Default bounding box for animation area (north, south, east, west coordinates)",
                        "type": "object",
                        "width": 12,
                        "object": [
                            {
                                "field": "north",
                                "name": "North",
                                "description": "Northern boundary latitude",
                                "type": "number",
                                "width": 3,
                                "min": -90,
                                "max": 90,
                                "default": 90
                            },
                            {
                                "field": "south",
                                "name": "South",
                                "description": "Southern boundary latitude",
                                "type": "number",
                                "width": 3,
                                "min": -90,
                                "max": 90,
                                "default": -90
                            },
                            {
                                "field": "east",
                                "name": "East",
                                "description": "Eastern boundary longitude",
                                "type": "number",
                                "width": 3,
                                "min": -180,
                                "max": 180,
                                "default": 180
                            },
                            {
                                "field": "west",
                                "name": "West",
                                "description": "Western boundary longitude",
                                "type": "number",
                                "width": 3,
                                "min": -180,
                                "max": 180,
                                "default": -180
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

