{
    "defaultIcon": "brightness-4",
    "description": "Line-of-sight visibility analysis for SPICE bodies over terrain (React).",
    "descriptionFull": {
        "title": "Computes and visualizes line-of-sight visibility to orbiting or celestial targets over terrain.",
        "example": {
            "dem": "Data/missionDEM.tif",
            "data": [
                {
                    "name": "User-friendly name for DEM",
                    "demtileurl": "pathToDEMTiles/{z}/{x}/{y}.png",
                    "minZoom": 8,
                    "maxNativeZoom": 18,
                    "boundingBox": [-122.51, 37.71, -122.41, 37.78]
                }
            ],
            "sources": [
                {
                    "name": "User-friendly name for orbiter or body",
                    "value": "NAIF SPICE Spacecraft name or ID"
                },
                {
                    "name": "...",
                    "value": "..."
                }
            ],
            "observers": [
                {
                    "name": "User-friendly name for observer for spacecraft time computations. Set to null to turn off time converting.",
                    "value": "SPICE Spacecraft name or ID",
                    "frame": "SPICE reference frame. i.e. IAU_MARS",
                    "body": "SPICE planet body. i.e. MARS",
                    "type": "Optional. 'lsmt' for lunar local solar mean time."
                }
            ],
            "defaultHeight": 0,
            "observerTimePlaceholder": "SOL-ddddMhh:mm:ss",
            "utcTimeFormat": "%Y-%m-%dT%H:%M:%SZ",
            "sweepColorRamps": [
                {
                    "name": "viridis",
                    "label": "Viridis",
                    "bins": 6
                }
            ]
        }
    },
    "hasVars": true,
    "name": "Sightline",
    "toolbarPriority": 102,
    "paths": {
        "SightlineTool": "essence/Tools/Sightline/SightlineTool",
        "SightlineTool_Algorithm": "essence/Tools/Sightline/SightlineTool_Algorithm"
    },
    "expandable": true,
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.dem",
                        "name": "DEM path",
                        "description": "A path to a Cloud Optimized GeoTIFF (COG) DEM. Used to compute terrain occlusion and elevation profiles.",
                        "type": "text",
                        "width": 12
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.data",
                        "name": "Layer-specific DEMs",
                        "description": "Optional additional DEM sources selectable by the user. Each entry provides a named DEM with tile URL and extent.",
                        "type": "objectarray",
                        "width": 12,
                        "object": [
                            {
                                "field": "name",
                                "name": "Name",
                                "description": "User-friendly name for this DEM",
                                "type": "text",
                                "width": 2
                            },
                            {
                                "field": "demtileurl",
                                "name": "DEM Tile URL",
                                "description": "Path to DEM RGB-encoded tiles: {z}/{x}/{y}.png",
                                "type": "text",
                                "width": 6
                            },
                            {
                                "field": "minZoom",
                                "name": "Min Zoom",
                                "description": "Minimum zoom level for tiles",
                                "type": "number",
                                "min": 0,
                                "step": 1,
                                "width": 1
                            },
                            {
                                "field": "maxNativeZoom",
                                "name": "Max Native Zoom",
                                "description": "Maximum native zoom level",
                                "type": "number",
                                "min": 0,
                                "step": 1,
                                "width": 1
                            },
                            {
                                "field": "boundingBox",
                                "name": "Bounding Box",
                                "description": "west,south,east,north. Clamps tile requests to this extent.",
                                "type": "textarray",
                                "width": 2
                            }
                        ]
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.sources",
                        "name": "Sources",
                        "description": "SPICE bodies to compute line-of-sight visibility for (e.g. Sun, orbiters, relay satellites).",
                        "type": "objectarray",
                        "width": 12,
                        "object": [
                            {
                                "field": "name",
                                "name": "Name",
                                "description": "User-friendly name",
                                "type": "text",
                                "width": 6
                            },
                            {
                                "field": "value",
                                "name": "SPICE Value",
                                "description": "NAIF SPICE Spacecraft name or ID",
                                "type": "text",
                                "width": 6
                            }
                        ]
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.observers",
                        "name": "Observers",
                        "description": "Ground observers for spacecraft clock and local time conversions (e.g. MSL Sol, Mars 2020 Sol, LSMT).",
                        "type": "objectarray",
                        "width": 12,
                        "object": [
                            {
                                "field": "name",
                                "name": "Name",
                                "description": "User-friendly display name for this observer",
                                "type": "text",
                                "width": 3
                            },
                            {
                                "field": "value",
                                "name": "SPICE Value",
                                "description": "SPICE spacecraft name or ID (e.g. MSL, MARS2020)",
                                "type": "text",
                                "width": 3
                            },
                            {
                                "field": "frame",
                                "name": "Reference Frame",
                                "description": "e.g. IAU_MARS",
                                "type": "text",
                                "width": 3
                            },
                            {
                                "field": "body",
                                "name": "Planet Body",
                                "description": "e.g. MARS",
                                "type": "text",
                                "width": 3
                            }
                        ]
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.defaultHeight",
                        "name": "Default Height (m)",
                        "description": "Default height above surface.",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "width": 6
                    },
                    {
                        "field": "variables.observerTimePlaceholder",
                        "name": "Observer Time Placeholder",
                        "description": "Placeholder text shown in observer time inputs (e.g. SOL-ddddMhh:mm:ss, LDAY-NNNNNLHH:MM:SS)",
                        "type": "text",
                        "width": 6
                    }
                ]
            }
        ]
    }
}
