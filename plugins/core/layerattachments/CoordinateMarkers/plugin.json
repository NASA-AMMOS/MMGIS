{
  "name": "CoordinateMarkers",
  "type": "layerattachment",
  "attachmentId": "coordinate_markers",
  "version": "1.0.0",
  "tier": "core",
  "overridable": false,
  "configPath": "variables.coordinateAttachments.marker",
  "description": "A marker at every coordinate pair of every one of the host layer's features. Requires Enhanced GeoJSON features with 'coord_properties' defined.",
  "capabilities": {
    "renderers": {
      "map": {
        "engines": ["leaflet"]
      },
      "globe": false
    },
    "host": {
      "order": 5
    }
  },
  "metaconfig": "./metaconfig.json",
  "paths": {
    "plugin": "./coordinateMarkers"
  },
  "applicableLayerTypes": ["vector", "query"]
}
