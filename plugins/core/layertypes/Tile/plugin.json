{
  "name": "Tile",
  "type": "layertype",
  "typeId": "tile",
  "version": "1.0.0",
  "tier": "core",
  "overridable": true,
  "description": "Raster tile layer (TMS/WMTS/COG/STAC) rendered as a Leaflet tileLayer on the map and imagery on the globe.",
  "capabilities": {
    "renderers": {
      "map": true,
      "globe": { "engines": ["cesium", "lithosphere"] }
    },
    "time": true,
    "filtering": false,
    "identify": false
  },
  "fileTypes": ["tms", "wmts", "cog", "stac-collection"],
  "metaconfig": "./metaconfig.json",
  "paths": {
    "map": "./map/tile",
    "globe.cesium": "./globe/cesium/tile",
    "globe.lithosphere": "./globe/lithosphere/tile"
  }
}
