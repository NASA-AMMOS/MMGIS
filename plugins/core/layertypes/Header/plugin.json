                  "vector",
                  "vectortile",
                  "velocity",
                  "video"
                ]
              },
              {
                "field": "name",
                "name": "Layer Name",
                "description": "",
                "type": "textnotrim",
                "width": 8,
                "required": true
              },
              {
                "field": "expanded",
                "name": "Expanded",
                "description": "Whether all child layers under the header default to being expanded (as opposed to being collapsed).",
