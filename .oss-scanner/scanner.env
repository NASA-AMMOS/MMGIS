# .env for the OSS Scanner image (copied to /src/.env at build time; SECRET is appended there).
# Local-only sandbox values. Do not use for a real deployment; start from /sample.env instead.
SERVER=node
PORT=8888
AUTH=local
AUTH_LOCAL_ALLOW_SIGNUP=false
HTTPS=false
VERBOSE_LOGGING=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mmgis
DB_USER=mmgis
DB_PASS=mmgis
DB_USER_TEST=mmgis
DB_PASS_TEST=mmgis
DB_SSL=false

# Adjacent servers (STAC, TiPG, TiTiler, Veloserver) run as separate services in production; off here
WITH_STAC=false
WITH_TIPG=false
WITH_TITILER=false
WITH_TITILER_PGSTAC=false
WITH_VELOSERVER=false
