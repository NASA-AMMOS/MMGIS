{
  "name": "visualize_contours",
  "description": "Draw contour overlays for thresholded variables and highlight the selected area.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["layer_name", "variable", "operator", "value"],
    "properties": {
      "layer_name": {
        "type": "string",
        "minLength": 1,
        "description": "Layer display name or alias."
      },
      "variable": {
        "type": "string",
        "minLength": 1,
        "description": "Variable name within the layer to evaluate."
      },
      "operator": {
        "type": "string",
        "enum": [">", ">=", "<", "<=", "="],
        "description": "Comparison operator for the threshold."
      },
      "value": {
        "type": "number",
        "description": "Threshold value for the comparison."
      },
      "time": {
        "type": "string",
        "description": "ISO timestamp or label for the requested time slice."
      },
      "geographical_area": {
        "type": "string",
        "description": "Optional named area to focus contours."
      }
    }
  },
  "modelParameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["layer_name", "variable", "operator", "value"],
    "properties": {
      "layer_name": {
        "type": "string"
      },
      "variable": {
        "type": "string"
      },
      "operator": {
        "type": "string",
        "enum": [">", ">=", "<", "<=", "="]
      },
      "value": {
        "type": "number"
      },
      "time": {
        "type": "string"
      },
      "geographical_area": {
        "type": "string"
      }
    }
  },
  "execution": {
    "adapter": "custom",
    "ui": {
      "type": "contour_overlay"
    }
  }
}
