# /etc/mmgis/mmgis.env - read by mmgis.container
# Podman env files are literal: no quotes around values, no inline comments.
# Any ENV from sample.env can be added here; see
# https://nasa-ammos.github.io/MMGIS/setup/envs

SERVER=node
PORT=8888
NODE_ENV=production

# public || optional || required
SITE_ACCESS=optional
AUTH_PROVIDERS=["local"]

# Required. Generate one with: openssl rand -hex 64
SECRET=CHANGE_ME

# Terminate TLS in a reverse proxy in front of port 8888
HTTPS=false

# Database: the mmgis-db container, by its network alias
DB_HOST=db
DB_PORT=5432
DB_NAME=mmgis
DB_USER=mmgis
DB_PASS=CHANGE_ME

# Adjacent servers run in their own containers (mmgis-titiler, mmgis-stac)
ADJACENT_SERVERS_MODE=external
WITH_STAC=true
STAC_PORT=8881
WITH_TITILER=true
TITILER_PORT=8883
WITH_TIPG=false
WITH_TITILER_PGSTAC=false
WITH_VELOSERVER=false

# URLs TiTiler may open: https and local files under /Missions
TITILER_ALLOWED_URL_PATTERNS=["^https://(?!.*\\.\\.)(?!.*\\x00).*$", "^/Missions/(?!.*\\.\\.).*$"]
