{
  "name": "mmgis",
  "version": "5.0.13-20260521",
  "description": "A web-based mapping and localization solution for science operation on planetary missions.",
  "homepage": "build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NASA-AMMOS/MMGIS.git"
  },
  "keywords": [
    "tile",
    "planet",
    "earth",
    "mars",
    "graphics",
    "globe",
    "orbit",
    "dem",
    "gdal",
    "gdal2tiles",
    "3d",
    "nasa",
    "mosaic",
    "gis",
    "tools",
    "map",
    "threejs",
    "rendering",
    "geometry",
    "terrain",
    "mmgis",
    "esri",
    "leaflet",
    "openlayers",
    "mapbox",
    "cesium"
  ],
  "scripts": {
    "start": "node scripts/init-db.js && node scripts/server.js",
    "start:prod": "node scripts/init-db.js && cross-env NODE_ENV=production node scripts/server.js",
    "start:prod-docker": "node scripts/init-db.js && cross-env NODE_ENV=production node scripts/server.js",
    "start:prod:with_examples": "cross-env NODE_ENV=production node scripts/server.js --with_examples",
    "start:docs": "cd ./docs && bundle exec jekyll serve",
    "start:analyzer": "node scripts/server.js --analyze",
    "build": "node scripts/build.js",
    "postinstall": "node -e \"if(require('fs').existsSync('scripts/resolve-plugin-deps.js')&&require('fs').existsSync('scripts/install-plugin-deps.js'))require('child_process').execSync('node scripts/resolve-plugin-deps.js && node scripts/install-plugin-deps.js',{stdio:'inherit'})\"",
    "plugins:install": "node scripts/resolve-plugin-deps.js && node scripts/install-plugin-deps.js",
    "test": "playwright test",
    "test:unit": "cross-env PLAYWRIGHT_TEST_UNIT_ONLY=true playwright test tests/unit",
    "test:e2e": "cross-env DB_NAME=mmgis-test playwright test tests/e2e",
    "test:e2e:api": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/api",
    "test:e2e:auth-off": "cross-env DB_NAME=mmgis-test AUTH=off playwright test tests/e2e/auth",
    "test:e2e:auth-local": "cross-env DB_NAME=mmgis-test AUTH=local playwright test tests/e2e/auth",
    "test:e2e:map": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/map",
    "test:e2e:time": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/time",
    "test:e2e:tools": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/tools",
    "test:e2e:security": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/security",
    "test:e2e:configure": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/configure",
    "test:e2e:collaboration": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/collaboration",
    "test:e2e:performance": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/performance",
    "test:e2e:accessibility": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/accessibility",
    "test:e2e:mobile": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/mobile",
    "test:e2e:cross-browser": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/cross-browser",
    "test:e2e:startup": "cross-env DB_NAME=mmgis-test playwright test tests/e2e/startup",
    "test:clean": "node --experimental-vm-modules tests/test-db-clean.js",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "start:test": "cross-env NODE_ENV=test PORT=18888 DB_NAME=mmgis-test HIDE_CONFIG=false node scripts/server.js"
  },
